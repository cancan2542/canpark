---
import { JAPAN_VIEW_BOX, PREFECTURE_MAP_DATA } from "./map-data";

type PrefectureLink = {
  name: string;
  slug: string;
};

type Props = {
  prefectures: PrefectureLink[];
  class?: string;
};

const { prefectures, class: className = "" } = Astro.props;
const activePrefectures = new Map(prefectures.map((prefecture) => [prefecture.slug, prefecture]));

function safeSegment(value: string): string {
  return encodeURIComponent(value);
}
---

<svg
  class:list={["japan-map", className]}
  data-testid="japan-map"
  viewBox={JAPAN_VIEW_BOX}
  role="group"
  aria-label="都道府県から記事を探す日本地図"
  preserveAspectRatio="xMidYMid meet"
>
  {
    PREFECTURE_MAP_DATA.map((prefecture) => {
      const active = activePrefectures.get(prefecture.slug);
      const name = active?.name ?? prefecture.name;
      const tooltipWidth = Math.max(170, [...name].length * 48 + 54);
      const tooltipX = Math.max(8, Math.min(2042 - tooltipWidth, prefecture.labelX - tooltipWidth / 2));
      const tooltipY = Math.max(10, prefecture.labelY - 88);

      return (
        <g class:list={["prefecture", { active }]}>
          {active ? (
            <a
              href={`/prefectures/${safeSegment(active.slug)}`}
              aria-label={`${name}の記事を見る`}
            >
              <path d={prefecture.path} vector-effect="non-scaling-stroke" />
            </a>
          ) : (
            <path d={prefecture.path} vector-effect="non-scaling-stroke" />
          )}
          <g class="tooltip" aria-hidden="true" pointer-events="none">
            <rect x={tooltipX} y={tooltipY} width={tooltipWidth} height="64" rx="14" />
            <text x={tooltipX + tooltipWidth / 2} y={tooltipY + 43} text-anchor="middle">
              {name}
            </text>
          </g>
        </g>
      );
    })
  }
</svg>

<style>
  .japan-map {
    display: block;
    width: 100%;
    max-height: min(78vh, 820px);
    overflow: visible;
  }

  .prefecture path {
    fill: #fff;
    stroke: #68756f;
    stroke-width: 1.35px;
  }

  .prefecture.active path {
    cursor: pointer;
    fill: #eef7f2;
  }

  .prefecture.active a:hover path,
  .prefecture.active a:focus-visible path {
    fill: #b9decf;
    stroke: #174d3d;
    stroke-width: 2.5px;
    outline: none;
  }

  .tooltip {
    visibility: hidden;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .prefecture:hover .tooltip,
  .prefecture:focus-within .tooltip {
    visibility: visible;
    opacity: 1;
  }

  .tooltip rect {
    fill: #17221e;
    stroke: #fff;
    stroke-width: 2px;
  }

  .tooltip text {
    fill: #fff;
    font-family: system-ui, sans-serif;
    font-size: 38px;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .tooltip {
      transition: none;
    }
  }
</style>
