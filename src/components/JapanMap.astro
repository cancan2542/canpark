---
import { JAPAN_VIEW_BOX, PREFECTURE_MAP_DATA } from "./map-data";

type PrefectureLink = {
  name: string;
  slug: string;
};

type Props = {
  prefectures: PrefectureLink[];
  class?: string;
};

const { prefectures, class: className = "" } = Astro.props;
const activePrefectures = new Map(prefectures.map((prefecture) => [prefecture.slug, prefecture]));
const mapRight = 2250;

function safeSegment(value: string): string {
  return encodeURIComponent(value);
}
---

<svg
  class:list={["japan-map", className]}
  data-testid="japan-map"
  viewBox={JAPAN_VIEW_BOX}
  role="group"
  aria-label="都道府県から記事を探す日本地図"
  preserveAspectRatio="xMidYMid meet"
>
  <g class="prefecture-boundaries" aria-hidden="true">
    {
      PREFECTURE_MAP_DATA.map((prefecture) => (
        <path
          class:list={["prefecture-boundary", { active: activePrefectures.has(prefecture.slug) }]}
          d={prefecture.path}
          vector-effect="non-scaling-stroke"
        />
      ))
    }
  </g>
  {
    PREFECTURE_MAP_DATA.map((prefecture) => {
      const active = activePrefectures.get(prefecture.slug);
      const name = active?.name ?? prefecture.name;
      const tooltipWidth = Math.max(156, [...name].length * 38 + 42);
      const tooltipX = Math.max(10, Math.min(mapRight - tooltipWidth - 10, prefecture.labelX - tooltipWidth / 2));
      const tooltipY = Math.max(10, prefecture.labelY - 80);
      const pointerX = Math.max(tooltipX + 24, Math.min(tooltipX + tooltipWidth - 24, prefecture.labelX));

      return (
        <g class:list={["prefecture-target", { active }]}>
          {active ? (
            <a
              href={`/prefectures/${safeSegment(active.slug)}`}
              aria-label={`${name}の記事を見る`}
            >
              <path class="hit-area" d={prefecture.path} vector-effect="non-scaling-stroke" />
              <g class="tooltip" aria-hidden="true" pointer-events="none">
                <rect x={tooltipX} y={tooltipY} width={tooltipWidth} height="56" rx="28" />
                <path class="tooltip-pointer" d={`M ${pointerX - 10} ${tooltipY + 54} L ${pointerX} ${tooltipY + 68} L ${pointerX + 10} ${tooltipY + 54} Z`} />
                <text x={tooltipX + tooltipWidth / 2} y={tooltipY + 38} text-anchor="middle">
                  {name}
                </text>
              </g>
            </a>
          ) : (
            <>
              <path class="hit-area" d={prefecture.path} vector-effect="non-scaling-stroke" />
              <g class="tooltip" aria-hidden="true" pointer-events="none">
                <rect x={tooltipX} y={tooltipY} width={tooltipWidth} height="56" rx="28" />
                <path class="tooltip-pointer" d={`M ${pointerX - 10} ${tooltipY + 54} L ${pointerX} ${tooltipY + 68} L ${pointerX + 10} ${tooltipY + 54} Z`} />
                <text x={tooltipX + tooltipWidth / 2} y={tooltipY + 38} text-anchor="middle">
                  {name}
                </text>
              </g>
            </>
          )}
        </g>
      );
    })
  }
</svg>

<style>
  .japan-map {
    display: block;
    width: min(100%, 960px);
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }

  .prefecture-boundary {
    fill: #fff;
    stroke: #68756f;
    stroke-width: 1.35px;
  }

  .prefecture-boundary.active {
    fill: #eef7f2;
  }

  .hit-area {
    fill: transparent;
    stroke: transparent;
    stroke-width: 1.35px;
    pointer-events: all;
  }

  .prefecture-target.active .hit-area {
    cursor: pointer;
  }

  .prefecture-target.active a:focus-visible {
    outline: none;
  }

  .prefecture-target.active a:hover .hit-area,
  .prefecture-target.active a:focus-visible .hit-area {
    fill: #b9decf;
    stroke: #174d3d;
    stroke-width: 2.5px;
    outline: none;
  }

  .tooltip {
    visibility: hidden;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .prefecture-target:hover .tooltip,
  .prefecture-target:focus-within .tooltip {
    visibility: visible;
    opacity: 1;
  }

  .tooltip rect {
    fill: #174d3d;
    stroke: #d9eee5;
    stroke-width: 1.5px;
    filter: drop-shadow(0 8px 10px rgb(23 34 30 / 0.24));
  }

  .tooltip-pointer {
    fill: #174d3d;
  }

  .tooltip text {
    fill: #fff;
    font-family: system-ui, sans-serif;
    font-size: 30px;
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  @media (prefers-reduced-motion: reduce) {
    .tooltip {
      transition: none;
    }
  }
</style>
