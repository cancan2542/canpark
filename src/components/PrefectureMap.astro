---
import type { MapSpot } from "../types/content";
import { PREFECTURE_MAP_DATA, projectMapCoordinates } from "./map-data";

type Props = {
  prefectureSlug: string;
  spots: MapSpot[];
  class?: string;
};

const { prefectureSlug, spots, class: className = "" } = Astro.props;
const prefecture = PREFECTURE_MAP_DATA.find((item) => item.slug === prefectureSlug);

if (!prefecture) {
  throw new Error(`Unsupported prefecture slug: ${prefectureSlug}`);
}

const [viewX, viewY, viewWidth, viewHeight] = prefecture.viewBox.split(" ").map(Number);
const visibleSpots = spots
  .filter(
    (spot) =>
      spot.coordinates !== null &&
      Number.isFinite(spot.coordinates.latitude) &&
      Number.isFinite(spot.coordinates.longitude),
  )
  .map((spot, index) => {
    const [x, y] = projectMapCoordinates(
      spot.coordinates!.longitude,
      spot.coordinates!.latitude,
    );
    return {
      ...spot,
      left: ((x - viewX) / viewWidth) * 100,
      top: ((y - viewY) / viewHeight) * 100,
      delay: Math.min(index, 12) * 90,
      tooltipEdge:
        ((x - viewX) / viewWidth) * 100 < 20
          ? "left"
          : ((x - viewX) / viewWidth) * 100 > 80
            ? "right"
            : "center",
    };
  })
  .filter((spot) => spot.left >= 0 && spot.left <= 100 && spot.top >= 0 && spot.top <= 100);

function safeSegment(value: string): string {
  return encodeURIComponent(value);
}
---

<div
  class:list={["prefecture-map", className]}
  data-testid="prefecture-map"
  style={`aspect-ratio: ${viewWidth} / ${viewHeight}`}
  role="group"
  aria-label={`${prefecture.name}の記事スポット地図`}
>
  <svg viewBox={prefecture.viewBox} aria-hidden="true" preserveAspectRatio="none">
    <path d={prefecture.path} vector-effect="non-scaling-stroke" />
  </svg>
  {
    visibleSpots.map((spot) => (
      <a
        class:list={["spot-pin", `tooltip-${spot.tooltipEdge}`]}
        href={`/spots/${safeSegment(spot.slug)}`}
        aria-label={`${spot.title}の記事を読む`}
        style={`--pin-left:${spot.left}%;--pin-top:${spot.top}%;--pin-delay:${spot.delay}ms`}
      >
        <span class="pin-shape" aria-hidden="true">
          <span class="pin-dot" />
        </span>
        <span class="spot-tooltip">{spot.title}</span>
      </a>
    ))
  }
</div>

<style>
  .prefecture-map {
    position: relative;
    width: 100%;
    min-height: 260px;
    isolation: isolate;
  }

  .prefecture-map > svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .prefecture-map > svg path {
    fill: #fff;
    stroke: #51625b;
    stroke-width: 1.5px;
  }

  .spot-pin {
    position: absolute;
    z-index: 1;
    left: var(--pin-left);
    top: var(--pin-top);
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    color: inherit;
    text-decoration: none;
    transform: translate(-50%, -100%);
    animation: pin-drop 560ms cubic-bezier(0.22, 0.9, 0.38, 1.15) both;
    animation-delay: var(--pin-delay);
  }

  .pin-shape {
    position: relative;
    display: grid;
    width: 26px;
    height: 26px;
    place-items: center;
    border: 2px solid #fff;
    border-radius: 50% 50% 50% 0;
    background: #1f5b49;
    box-shadow: 0 2px 7px rgb(23 34 30 / 32%);
    transform: rotate(-45deg);
  }

  .pin-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
  }

  .spot-tooltip {
    position: absolute;
    bottom: calc(100% + 7px);
    left: 50%;
    visibility: hidden;
    width: max-content;
    max-width: min(280px, 75vw);
    padding: 8px 11px;
    border-radius: 7px;
    background: #17221e;
    box-shadow: 0 3px 12px rgb(23 34 30 / 24%);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.45;
    overflow-wrap: anywhere;
    opacity: 0;
    transform: translateX(-50%) translateY(3px);
    transition: opacity 120ms ease, transform 120ms ease, visibility 120ms;
  }

  .spot-pin.tooltip-left .spot-tooltip {
    left: 0;
    transform: translateX(0) translateY(3px);
  }

  .spot-pin.tooltip-right .spot-tooltip {
    right: 0;
    left: auto;
    transform: translateX(0) translateY(3px);
  }

  .spot-pin:hover,
  .spot-pin:focus-visible {
    z-index: 2;
    outline: none;
  }

  .spot-pin:hover .pin-shape,
  .spot-pin:focus-visible .pin-shape {
    background: #123e31;
    box-shadow: 0 0 0 4px rgb(31 91 73 / 22%), 0 2px 7px rgb(23 34 30 / 32%);
  }

  .spot-pin:hover .spot-tooltip,
  .spot-pin:focus-visible .spot-tooltip {
    visibility: visible;
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .spot-pin.tooltip-left:hover .spot-tooltip,
  .spot-pin.tooltip-left:focus-visible .spot-tooltip,
  .spot-pin.tooltip-right:hover .spot-tooltip,
  .spot-pin.tooltip-right:focus-visible .spot-tooltip {
    transform: translateX(0) translateY(0);
  }

  @keyframes pin-drop {
    from {
      opacity: 0;
      transform: translate(-50%, calc(-100% - 110px));
    }
    68% {
      opacity: 1;
      transform: translate(-50%, calc(-100% + 7px));
    }
    to {
      opacity: 1;
      transform: translate(-50%, -100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spot-pin {
      animation: none;
    }

    .spot-tooltip {
      transition: none;
    }
  }
</style>
