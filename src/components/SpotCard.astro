---
import type { Spot } from "@/types/content";

type Props = {
  spot: Spot;
};

const { spot } = Astro.props;
---

<article class="rounded border border-zinc-200 bg-white p-4">
  <div class="flex flex-wrap items-center gap-2 text-xs text-zinc-500">
    <span>{spot.prefecture}</span>
    <span>/</span>
    <span>{spot.municipality}</span>
    <span class="rounded bg-mist px-2 py-0.5 text-ink">{spot.genre.name}</span>
  </div>
  <h3 class="mt-2 text-lg font-semibold text-ink">
    <a href={`/spots/${spot.slug}`} class="hover:text-pine">{spot.title}</a>
  </h3>
  <p class="mt-2 line-clamp-3 text-sm leading-6 text-zinc-700">{spot.body}</p>
  <p class="mt-3 text-xs text-zinc-500">ハザード確認日: {spot.hazardCheckedAt}</p>
</article>
