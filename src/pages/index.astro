---
import DisclaimerNotice from "@/components/DisclaimerNotice.astro";
import JapanMap from "@/components/JapanMap.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import SpotCard from "@/components/SpotCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPrefectures, getSpots } from "@/lib/content";

const [prefectures, spots] = await Promise.all([getPrefectures(), getSpots()]);
const prefectureSlugsWithSpots = new Set(spots.map((spot) => spot.prefectureSlug));
const selectablePrefectures = prefectures
  .filter((prefecture) => prefectureSlugsWithSpots.has(prefecture.slug))
  .map(({ name, slug }) => ({ name, slug }));
---

<BaseLayout canonicalPath="/">
  <div class="mx-auto max-w-6xl px-4 py-8">
    <section class="grid gap-8 lg:grid-cols-[1fr_360px]">
      <div>
        <p class="text-sm font-semibold text-pine">車中泊スポットとハザード確認メモ</p>
        <h1 class="mt-3 text-4xl font-bold tracking-normal text-ink sm:text-5xl">
          地図から、泊まりたい場所と避けたい条件を一緒に見る。
        </h1>
        <p class="mt-4 max-w-3xl text-base leading-7 text-zinc-700">
          実際に訪れた車中泊スポットを、公式ハザードマップの確認結果と現地で見た道幅・標高感・周辺環境のメモつきで紹介します。
        </p>
      </div>
      <DisclaimerNotice />
    </section>

    <section class="mt-8" aria-label="都道府県地図">
      <JapanMap prefectures={selectablePrefectures} />
    </section>

    <section class="mt-10">
      <SectionHeader title="都道府県から探す" description="初期版は地域導線を中心に整備しています。" />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {prefectures.map((prefecture) => (
          <a
            href={`/prefectures/${prefecture.slug}`}
            class="rounded border border-zinc-200 bg-white p-4 hover:border-pine"
          >
            <h3 class="font-semibold text-ink">{prefecture.name}</h3>
            <p class="mt-2 text-sm leading-6 text-zinc-600">{prefecture.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <SectionHeader title="最新スポット" />
      <div class="grid gap-4 md:grid-cols-2">
        {spots.map((spot) => <SpotCard spot={spot} />)}
      </div>
    </section>
  </div>
</BaseLayout>
