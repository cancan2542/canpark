---
import SectionHeader from "@/components/SectionHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSpots } from "@/lib/content";
import type { Spot } from "@/types/content";

type Props = {
  spot: Spot;
};

export async function getStaticPaths() {
  const spots = await getSpots();
  return spots.map((spot) => ({
    params: { slug: spot.slug },
    props: { spot },
  }));
}

const { spot } = Astro.props;
---

<BaseLayout
  title={`${spot.title}の車中泊メモ`}
  description={spot.body}
  canonicalPath={`/spots/${spot.slug}`}
>
  <article class="mx-auto max-w-4xl px-4 py-8">
    <div class="flex flex-wrap items-center gap-2 text-sm text-zinc-500">
      <span>{spot.prefecture}</span>
      <span>/</span>
      <span>{spot.municipality}</span>
      <span class="rounded bg-mist px-2 py-0.5 text-ink">{spot.genreName}</span>
    </div>
    <h1 class="mt-3 text-4xl font-bold text-ink">{spot.title}</h1>
    <p class="mt-3 text-sm text-zinc-500">訪問日: {spot.visitedAt}</p>

    <section class="mt-8">
      <SectionHeader title="旅行メモ" />
      <p class="whitespace-pre-line text-base leading-8 text-zinc-700">{spot.body}</p>
    </section>
  </article>
</BaseLayout>
