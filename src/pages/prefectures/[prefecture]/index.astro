---
import PrefectureMap from "@/components/PrefectureMap.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import SpotCard from "@/components/SpotCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  getMunicipalities,
  getPrefectures,
  getSpotsByPrefecture,
  toMapSpots,
} from "@/lib/content";
import type { Region, Spot } from "@/types/content";

type Props = {
  region: Region;
  municipalities: Region[];
  spots: Spot[];
};

export async function getStaticPaths() {
  const prefectures = await getPrefectures();
  return Promise.all(prefectures.map(async (region) => ({
    params: { prefecture: region.slug },
    props: {
      region,
      municipalities: await getMunicipalities(region.slug),
      spots: await getSpotsByPrefecture(region.slug),
    },
  })));
}

const { region, municipalities, spots } = Astro.props;
---

<BaseLayout title={`${region.name}の車中泊スポット`} canonicalPath={`/prefectures/${region.slug}`}>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <p class="text-sm text-zinc-500">都道府県</p>
    <h1 class="mt-2 text-4xl font-bold text-ink">{region.name}</h1>

    <section class="mt-8" aria-label={`${region.name}のスポット地図`}>
      <PrefectureMap prefectureSlug={region.slug} spots={toMapSpots(spots)} />
    </section>

    <section class="mt-10">
      <SectionHeader title="市区町村" />
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {municipalities.map((municipality) => (
          <a
            href={`/prefectures/${region.slug}/${municipality.slug}`}
            class="rounded border border-zinc-200 bg-white p-4 hover:border-pine"
          >
            <h2 class="font-semibold text-ink">{municipality.name}</h2>
            <p class="mt-2 text-sm leading-6 text-zinc-600">{municipality.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mt-10">
      <SectionHeader title="スポット" />
      <div class="grid gap-4 md:grid-cols-2">
        {spots.map((spot) => <SpotCard spot={spot} />)}
      </div>
    </section>
  </div>
</BaseLayout>
